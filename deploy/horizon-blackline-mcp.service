[Unit]
Description=Horizon Blackline - Alpaca MCP sidecar (read-only + paper order tools)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=horizon
WorkingDirectory=/opt/horizon-blackline
ExecStart=/opt/horizon-blackline/bin/run-alpaca-mcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/horizon-blackline

[Install]
WantedBy=multi-user.target
