[Unit]
Description=Horizon Blackline - ProofRay sidecar (deterministic evidence verification)
After=network.target

[Service]
Type=simple
User=horizon
WorkingDirectory=/opt/horizon-blackline
ExecStart=/opt/horizon-blackline/bin/run-proofray
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/horizon-blackline /home/horizon/.config

[Install]
WantedBy=multi-user.target
