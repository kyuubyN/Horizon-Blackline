# Copie para .env e preencha apenas com as credenciais da conta Paper Alpaca.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_PAPER_ACCOUNT_ID=
ALPACA_TOOLSETS=account,trading,assets,stock-data,crypto-data,options-data,news,corporate-actions
ALPACA_MCP_URL=http://127.0.0.1:8001/mcp
DATOMIC_STORAGE_DIR=/home/your-user/path/to/horizon-blackline/.datomic
PORT=8080

# Official scoring campaign: leave disabled during normal development.
# The FAQ's 2026 scoring window is 09:30 ET = 13:30 UTC while EDT applies.
HORIZON_OFFICIAL_CAMPAIGN_ENABLED=false
HORIZON_AUTONOMY_ENABLED=false
HORIZON_OFFICIAL_ACCOUNT_ID=
HORIZON_OFFICIAL_STARTING_EQUITY=100000
HORIZON_OFFICIAL_WINDOW_START=2026-08-31T13:30:00Z
HORIZON_OFFICIAL_WINDOW_END=2026-09-04T13:30:00Z
HORIZON_EQUITY_SNAPSHOT_INTERVAL_SECONDS=60
