# Copy to .env and fill in only with Alpaca Paper account credentials.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_PAPER_ACCOUNT_ID=
ALPACA_TOOLSETS=account,trading,assets,stock-data,crypto-data,options-data,news,corporate-actions
ALPACA_MCP_URL=http://127.0.0.1:8001/mcp
DATOMIC_STORAGE_DIR=/home/your-user/path/to/horizon-blackline/.datomic
PORT=8080
# Empty = no authentication (default posture: the API only listens on 127.0.0.1). Fill in to
# require "Authorization: Bearer <token>" on every route except /health and /ready --
# recommended if the VM is multi-user, containerized, or behind any reverse proxy.
HORIZON_API_AUTH_TOKEN=

# Official scoring campaign: leave disabled during normal development.
# The FAQ's 2026 scoring window is 09:30 ET = 13:30 UTC while EDT applies.
HORIZON_OFFICIAL_CAMPAIGN_ENABLED=false
HORIZON_AUTONOMY_ENABLED=false
HORIZON_OFFICIAL_ACCOUNT_ID=
HORIZON_OFFICIAL_STARTING_EQUITY=100000
HORIZON_OFFICIAL_WINDOW_START=2026-08-31T13:30:00Z
HORIZON_OFFICIAL_WINDOW_END=2026-09-04T13:30:00Z
HORIZON_EQUITY_SNAPSHOT_INTERVAL_SECONDS=60

# Orchestrator: watchlist and risk limits for the autonomous loop.
# HORIZON_ORCHESTRATOR_EMBEDDED=true runs the loop inside the same bin/run-api process --
# required in production, since Datomic Local only accepts one process per storage-dir at a
# time. bin/run-orchestrator (a separate process) is only for dev/test against a disposable
# DATOMIC_STORAGE_DIR distinct from the API's.
HORIZON_ORCHESTRATOR_EMBEDDED=false
HORIZON_WATCHLIST=
HORIZON_ORCHESTRATOR_POLL_SECONDS=300
# Stop-loss monitoring runs on its own faster daemon thread so it isn't starved by discovery/LLM
# latency in the main tick! loop above.
HORIZON_MONITORING_POLL_SECONDS=30
HORIZON_RISK_BUDGET_USD=500
HORIZON_MAX_SYMBOL_WEIGHT=0.05
HORIZON_MAX_GROSS_EXPOSURE=0.20
# Options-only strategy: max acceptable bid-ask spread (% of mid) on the selected contract,
# not ADV participation -- see orchestrator.clj select-option-contract!.
HORIZON_MAX_ADV_PARTICIPATION=0.15
HORIZON_MAX_DRAWDOWN=0.03
HORIZON_ORDER_NOTIONAL_USD=1000
HORIZON_MIN_CONFIDENCE=0.6

# A tradeable thesis (buy/sell at/above MIN_CONFIDENCE) must recur for the same symbol and
# direction this many consecutive discovery ticks before an order is proposed -- the per-tick
# LLM judgment is noisy. 1 = act on the first tradeable tick. Streaks reset on process restart.
HORIZON_THESIS_CONFIRM_TICKS=2

# Broker-feed (Benzinga via Alpaca) news older than this many days is dropped before the
# strategy LLM sees it, instead of being presented as current -- coverage of thinly-traded or
# non-US tickers can lag the quote by months. 0 or empty disables the filter. Default: 21.
HORIZON_NEWS_MAX_AGE_DAYS=21

# When true, each tick also pulls current open-web coverage via the DuckDuckGo MCP sidecar
# (bin/run-ddg-mcp) and runs it through the same ProofRay -> LLM chain as broker news. If the
# sidecar is down or dry, the tick silently falls back to broker news only. Default: false.
HORIZON_WEB_RESEARCH_ENABLED=false
HORIZON_DDG_MCP_URL=http://127.0.0.1:8765/mcp

# Options strategy: every trade is a single-leg long call (bullish thesis) or long put
# (bearish thesis) -- never naked/short, so max loss is always bounded at the premium paid.
HORIZON_OPTION_STOP_LOSS_PCT=0.5
HORIZON_OPTION_EXPIRATION_MIN_DAYS=14
HORIZON_OPTION_EXPIRATION_MAX_DAYS=45
HORIZON_OPTION_STRIKE_BAND_PCT=0.05

# Strategy LLM: Featherless is primary, Gemini is the fallback when credit runs out.
FEATHER_API_KEY=
GEMINI_API_KEY=

# Test: if set, GROQ_API_KEY becomes the first provider in the chain (free/cheap),
# without spending Featherless credit. Delete it to go back to Featherless as primary.
GROQ_API_KEY=
HORIZON_GROQ_MODEL=
# Optional: overrides the defaults. Featherless is a single model; Gemini is an
# ordered chain (each model has its own rate limit, so a 429 skips to the next instead of failing).
# Default if empty: gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
HORIZON_FEATHER_MODEL=
HORIZON_GEMINI_MODELS=

# ProofRay (HorizonMemory) deterministic-evidence sidecar.
PROOFRAY_URL=http://127.0.0.1:8420
# "default" or "personal" (more chunks/noise, higher precision with a capable LLM judge -- see
# HorizonMemory's internal benchmarks on MemGym-DR). Empty = "default".
PROOFRAY_ENGINE_PROFILE=
