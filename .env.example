# Copie para .env e preencha apenas com as credenciais da conta Paper Alpaca.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
ALPACA_PAPER_ACCOUNT_ID=
ALPACA_TOOLSETS=account,trading,assets,stock-data,crypto-data,options-data,news,corporate-actions
ALPACA_MCP_URL=http://127.0.0.1:8001/mcp
DATOMIC_STORAGE_DIR=/home/your-user/path/to/horizon-blackline/.datomic
PORT=8080

# Official scoring campaign: leave disabled during normal development.
# The FAQ's 2026 scoring window is 09:30 ET = 13:30 UTC while EDT applies.
HORIZON_OFFICIAL_CAMPAIGN_ENABLED=false
HORIZON_AUTONOMY_ENABLED=false
HORIZON_OFFICIAL_ACCOUNT_ID=
HORIZON_OFFICIAL_STARTING_EQUITY=100000
HORIZON_OFFICIAL_WINDOW_START=2026-08-31T13:30:00Z
HORIZON_OFFICIAL_WINDOW_END=2026-09-04T13:30:00Z
HORIZON_EQUITY_SNAPSHOT_INTERVAL_SECONDS=60

# Orchestrator: watchlist e limites de risco do loop autônomo.
# HORIZON_ORCHESTRATOR_EMBEDDED=true roda o loop dentro do mesmo processo do bin/run-api --
# obrigatório em produção, já que o Datomic Local só aceita um processo por storage-dir por vez.
# bin/run-orchestrator (processo separado) é só para dev/teste contra um DATOMIC_STORAGE_DIR
# descartável e diferente do da API.
HORIZON_ORCHESTRATOR_EMBEDDED=false
HORIZON_WATCHLIST=
HORIZON_ORCHESTRATOR_POLL_SECONDS=300
HORIZON_RISK_BUDGET_USD=500
HORIZON_MAX_SYMBOL_WEIGHT=0.05
HORIZON_MAX_GROSS_EXPOSURE=0.20
HORIZON_MAX_ADV_PARTICIPATION=0.01
HORIZON_MAX_DRAWDOWN=0.03
HORIZON_STOP_DISTANCE_PCT=0.02
HORIZON_ORDER_NOTIONAL_USD=1000
HORIZON_MIN_CONFIDENCE=0.6

# Strategy LLM: Featherless é primário, Gemini é fallback quando o crédito acabar.
FEATHER_API_KEY=
GEMINI_API_KEY=

# Teste: se preenchida, GROQ_API_KEY vira o primeiro provedor da cadeia (gratuito/barato),
# sem gastar crédito do Featherless. Apague pra voltar ao Featherless como primário.
GROQ_API_KEY=
HORIZON_GROQ_MODEL=
# Opcional: sobrescreve os defaults. Featherless é um único modelo; Gemini é uma cadeia
# ordenada (cada modelo tem rate-limit próprio, então um 429 pula pro próximo em vez de falhar).
# Default se vazio: gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
HORIZON_FEATHER_MODEL=
HORIZON_GEMINI_MODELS=

# ProofRay (HorizonMemory) sidecar de evidência determinística.
PROOFRAY_URL=http://127.0.0.1:8420
# "default" ou "personal" (mais trechos/ruído, maior precisão com um LLM juiz capaz -- ver
# benchmarks internos do HorizonMemory no MemGym-DR). Vazio = "default".
PROOFRAY_ENGINE_PROFILE=
