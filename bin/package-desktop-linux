#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd "$(dirname "$0")/.." && pwd)
flutter="$project_root/.tools/flutter/bin/flutter"
bundle="$project_root/desktop_flutter/build/linux/x64/release/bundle"
backend="$bundle/backend"

if [[ ! -x "$flutter" ]]; then
  echo "Local Flutter not found at .tools/flutter."
  exit 1
fi

cd "$project_root/desktop_flutter"
"$flutter" build linux --release

rm -rf "$backend"
mkdir -p "$backend"
cp -a "$project_root/bin" "$backend/bin"
cp -a "$project_root/src" "$project_root/resources" "$project_root/deps.edn" "$backend/"
mkdir -p "$backend/.tools"
cp -a "$project_root/.tools/jdk" "$project_root/.tools/bin" "$project_root/.tools/clojure" "$project_root/.tools/clojure-config" "$project_root/.tools/clojure-tools" "$backend/.tools/"
# .m2 ships the resolved jars themselves (the classpath cache only stores
# paths into it), so it can't be dropped without a real uberjar/jlink build.
# Strip anything that looks like credential/config leakage as a minimum.
cp -a "$project_root/.m2" "$backend/.m2"
find "$backend/.m2" \( -iname "settings.xml" -o -iname "*credentials*" -o -iname ".netrc" \) -delete
cp -a "$project_root/.env.example" "$backend/.env.example"

echo "Bundle created: $bundle"
echo "Configure ALPACA_* in the environment or copy backend/.env.example to backend/.env."
echo "Note: backend/.m2 bundles the resolved Maven jars (needed to run); it contains no settings.xml/credentials after the cleanup above."
